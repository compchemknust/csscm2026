&CONTROL
 calculation='scf', prefix='fe'
 pseudo_dir='./pseudo', outdir='./tmp'
 tprnfor=.true., tstress=.true.
/
&SYSTEM
 ibrav=3, A=2.87, nat=1, ntyp=1
 ecutwfc=40, ecutrho=320, nbnd=16
 nspin=2, starting_magnetization(1)=0.5
 occupations='smearing', smearing='mv', degauss=0.02
/
&ELECTRONS
 conv_thr=1.0d-8, mixing_beta=0.4
/
ATOMIC_SPECIES
Fe 55.845 Fe.pbe-nd-rrkjus.UPF
ATOMIC_POSITIONS crystal
Fe 0.0 0.0 0.0
K_POINTS automatic
6 6 6 1 1 1

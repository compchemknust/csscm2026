&CONTROL
 calculation='scf', prefix='graphene'
 pseudo_dir='./pseudo', outdir='./tmp'
 tprnfor=.true., tstress=.true.
/
&SYSTEM
 ibrav=4, A=2.46, C=20.0, nat=2, ntyp=1
 ecutwfc=40, ecutrho=320, nbnd=8
 occupations='smearing', smearing='mv', degauss=0.005
/
&ELECTRONS
 conv_thr=1.0d-8, mixing_beta=0.4
/
ATOMIC_SPECIES
C 12.011 C.pbe-rrkjus.UPF
ATOMIC_POSITIONS crystal
C 0.0 0.0 0.5
C 0.3333333333 0.6666666667 0.5
K_POINTS automatic
9 9 1 0 0 0

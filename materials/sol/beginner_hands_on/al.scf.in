&CONTROL
 calculation='scf', prefix='al'
 pseudo_dir='./pseudo', outdir='./tmp'
 tprnfor=.true., tstress=.true.
/
&SYSTEM
 ibrav=2, A=4.05, nat=1, ntyp=1
 ecutwfc=40, ecutrho=160, nbnd=8
 occupations='smearing', smearing='mv', degauss=0.02
/
&ELECTRONS
 conv_thr=1.0d-8, mixing_beta=0.4
/
ATOMIC_SPECIES
Al 26.9815 Al.pz-vbc.UPF
ATOMIC_POSITIONS crystal
Al 0.0 0.0 0.0
K_POINTS automatic
8 8 8 1 1 1

&CONTROL
 calculation='scf', prefix='si'
 pseudo_dir='./pseudo', outdir='./tmp'
 tprnfor=.true., tstress=.true.
/
&SYSTEM
 ibrav=2, A=5.43, nat=2, ntyp=1
 ecutwfc=48, ecutrho=192
 occupations='fixed'
/
&ELECTRONS
 conv_thr=1.0d-8, mixing_beta=0.4
/
ATOMIC_SPECIES
Si 28.085 Si.pz-vbc.UPF
ATOMIC_POSITIONS alat
Si 0.00 0.00 0.00
Si 0.25 0.25 0.25
K_POINTS automatic
8 8 8 1 1 1

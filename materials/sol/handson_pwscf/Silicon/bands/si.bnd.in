 &control
    prefix='silicon',
    calculation='scf',
    ! this is a comment: you can comment out variables
    ! set pseudo_dir and outdir to suitable directories
    pseudo_dir = '/home/manuel/pseudo',
    outdir='../tmp',
 /
 &system    
    ibrav=  2, 
    celldm(1) =10.2129,
    nat=  2, ntyp= 1,
    ecutwfc = 32.0, 
 /
 &electrons
 /
ATOMIC_SPECIES
 Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS alat
 Si 0.00 0.00 0.00 
 Si 0.25 0.25 0.25 
! this is a comment 

 K_POINTS automatic
   6 6 6 1 1 1
